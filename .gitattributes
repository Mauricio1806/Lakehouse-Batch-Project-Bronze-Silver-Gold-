# ── GitHub Linguist overrides ─────────────────────────────────────────────────
# Auto-generated outputs — excluded from language statistics

# Plotly HTML executive reports (generated by src/analytics/report.py)
reports/*.html linguist-generated=true

# Grafana dashboard JSON and data exports (generated by src/analytics/grafana_export.py)
grafana/dashboards/*.json linguist-generated=true
grafana/data/*.json        linguist-generated=true

# AWS IAM / Athena DDL files — configuration, not application code
cloud/aws/iam/*.json       linguist-language=JSON
cloud/aws/athena/*.sql     linguist-language=SQL
